# Copiar a .env y completar con valores reales. NUNCA commitear .env con secretos reales.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (debe coincidir con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=examforge
DB_USER=examforge
DB_PASSWORD=change-me

# --- JWT ---
# Generar un secreto largo y aleatorio, por ejemplo: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Actuator ---
ACTUATOR_HEALTH_DETAILS=when-authorized

# --- Proveedor de IA (modulo 2: generacion RAG) ---
OPENAI_API_KEY=
